# BunkWise Environment Configuration Example
# Copy this file to .env.local for local overrides. Never commit actual secrets or live tokens.

# ==========================================
# PUBLIC FRONTEND CONFIGURATION (VITE_*)
# Note: Variables prefixed with VITE_ are embedded into client JavaScript bundles.
# NEVER place private passwords, server keys, or administrative credentials here.
# ==========================================

# Default institute / school code (e.g. 800002 for Chitkara University)
VITE_DEFAULT_SCHOOL_CODE=800002

# Application branding name
VITE_APP_NAME=BunkWise

# ==========================================
# SERVER-SIDE ONLY CONFIGURATION (Private)
# These variables are only accessible in serverless functions (api/proxy.js, api/feedback.js)
# and are never exposed to browser client bundles.
# ==========================================

# Optional secure webhook URL to receive feedback submissions (e.g., Discord/Telegram/Formspree webhook)
FEEDBACK_WEBHOOK_URL=
